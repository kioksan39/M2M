    overview: { full: "Generic Routing Encapsulation \xB7 SIM \u0438 APN", description: "GRE \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u043E\u0434\u0438\u043D \u0441\u0435\u0442\u0435\u0432\u043E\u0439 \u043F\u0430\u043A\u0435\u0442 \u0432\u043D\u0443\u0442\u0440\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E. \u0412 \u044D\u0442\u043E\u043C \u043F\u0440\u0438\u043C\u0435\u0440\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0441 SIM \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u043D\u044B\u0439 IP \u0438\u0437 Modem IP Pool \u0432 APN \u041C\u0422\u0421. \u041D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u041C\u0422\u0421 \u043F\u0430\u043A\u0435\u0442 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u043D\u0435\u0448\u043D\u0438\u043C IPv4-\u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u043E\u043C \u0438 GRE \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043E\u0440\u0443 \u043A\u043B\u0438\u0435\u043D\u0442\u0430. \u0422\u043E\u0442 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443 \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u043F\u0430\u043A\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u0443 LAN. \u041E\u0431\u0440\u0430\u0442\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0442\u043E\u0442 \u0436\u0435 \u043F\u0443\u0442\u044C. SIM \u0441\u0430\u043C\u0430 \u043D\u0435 \u0441\u0442\u0440\u043E\u0438\u0442 GRE-\u0442\u0443\u043D\u043D\u0435\u043B\u044C: \u0435\u0433\u043E \u043A\u043E\u043D\u0446\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0443 \u041C\u0422\u0421 \u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u0430. \u0421\u0445\u0435\u043C\u0430 \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F; \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u044E\u0442\u0441\u044F \u0441 \u041C\u0422\u0421.", facts: [["\u0423\u0440\u043E\u0432\u0435\u043D\u044C", "\u0421\u0435\u0442\u0435\u0432\u043E\u0439, L3"], ["\u0412\u043D\u0435\u0448\u043D\u0438\u0439 IPv4", "IP-\u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B 47, \u043D\u0435 TCP/UDP-\u043F\u043E\u0440\u0442"], ["\u0417\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A GRE", "4 \u0431\u0430\u0439\u0442\u0430 \u0432 \u0431\u0430\u0437\u043E\u0432\u043E\u043C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0435"], ["\u041E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 IPv4 + GRE", "20 + 4 = 24 \u0431\u0430\u0439\u0442\u0430 \u0431\u0435\u0437 \u043E\u043F\u0446\u0438\u0439"], ["Modem IP Pool", "10.20.0.0/24 \u2014 \u0430\u0434\u0440\u0435\u0441\u0430 SIM"], ["P2P \u0442\u0443\u043D\u043D\u0435\u043B\u044F", "172.16.100.0/30 \u2014 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0441\u0435\u0442\u044C"], ["LAN \u043A\u043B\u0438\u0435\u043D\u0442\u0430", "192.168.10.0/24"], ["\u0428\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0435", "\u041D\u0435\u0442; \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 GRE over IPsec"], ["\u0421\u043F\u0435\u0446\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F", "RFC 2784; \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F \u2014 RFC 2890"]] },
    start: { nodes: ["client"], frame: "client" },
    outro: { title: "\u041F\u0430\u043A\u0435\u0442 \u043F\u0440\u043E\u0448\u0451\u043B \u0442\u0443\u043D\u043D\u0435\u043B\u044C", desc: "SIM \u0438 \u0441\u0435\u0440\u0432\u0435\u0440 \u0432\u0438\u0434\u044F\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u0430", text: "SIM \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430 IP-\u043F\u0430\u043A\u0435\u0442 \u0432 APN. \u041C\u0422\u0421 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430 \u0432\u043D\u0435\u0448\u043D\u044E\u044E \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443 GRE, \u043A\u043B\u0438\u0435\u043D\u0442 \u0435\u0451 \u0441\u043D\u044F\u043B \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u043F\u0430\u043A\u0435\u0442 \u0432 LAN. \u041E\u0442\u0432\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043F\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443. GRE \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0434\u043E\u0441\u0442\u0443\u043F \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438, \u043D\u0435 \u0448\u0438\u0444\u0440\u0443\u0435\u0442 \u0434\u0430\u043D\u043D\u044B\u0435 \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u0438\u043B\u0438 firewall. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u043E\u0432\u0442\u043E\u0440, \u0447\u0442\u043E\u0431\u044B \u0435\u0449\u0451 \u0440\u0430\u0437 \u043F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u043E\u0431\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.", facts: [["SIM", "10.20.0.10 \u0438\u0437 10.20.0.0/24"], ["\u041A\u043E\u043D\u0446\u044B GRE", "198.51.100.10 \u2194 203.0.113.10"], ["P2P", "172.16.100.1 \u2194 172.16.100.2"], ["\u0423\u0447\u0435\u0431\u043D\u044B\u0439 ICMP", "60 B \u0432\u043D\u0443\u0442\u0440\u0438, 84 B \u0432 GRE"], ["\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430", "\u041E\u0431\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 + firewall + MTU"]] },
    steps: [
      { title: "SIM \u0438 APN", desc: "\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 IP \u0438\u0437 \u043F\u0443\u043B\u0430", detail: "SIM \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u0432 \u043C\u043E\u0434\u0435\u043C\u0435, \u043A\u0430\u0441\u0441\u0435 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435. \u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u043A \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u043C\u0443 APN \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0430\u044F \u0441\u0435\u0442\u044C \u0432\u044B\u0434\u0430\u0451\u0442 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0443 \u0430\u0434\u0440\u0435\u0441 10.20.0.10 \u0438\u0437 Modem IP Pool 10.20.0.0/24. APN \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F \u0432 \u043D\u0443\u0436\u043D\u0443\u044E \u0441\u0435\u0442\u044C; VRF \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432. SIM \u2014 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u0430\u0431\u043E\u043D\u0435\u043D\u0442\u0430, IP-\u043F\u0430\u043A\u0435\u0442\u044B \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E. \u0417\u0434\u0435\u0441\u044C \u0441\u0435\u0442\u044C \u0440\u0430\u0434\u0438\u043E\u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0438 \u044F\u0434\u0440\u043E \u041C\u0422\u0421 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u043E\u0434\u043D\u0438\u043C \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u043C.", facts: [["APN", "company.msk \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438\u043C\u0435\u0440"], ["Modem IP Pool", "10.20.0.0/24"], ["IP \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430", "10.20.0.10"], ["VRF", "\u0418\u0437\u043E\u043B\u044F\u0446\u0438\u044F \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432, \u043D\u0435 \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0435"]], events: [{ type: "show", nodes: ["router"], frame: "local" }, { type: "note", at: "client", text: "SIM \xB7 10.20.0.10", tone: "navy" }] },
      { title: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438\u0437 APN", desc: "\u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u043F\u0430\u043A\u0435\u0442 \u0438\u0434\u0451\u0442 \u043A \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u041C\u0422\u0421", detail: "\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u0435\u0441\u0442\u043E\u0432\u044B\u0439 ICMP Echo \u043A \u0441\u0435\u0440\u0432\u0435\u0440\u0443 192.168.10.10. \u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IP-\u043F\u0430\u043A\u0435\u0442 \u0438\u043C\u0435\u0435\u0442 \u0430\u0434\u0440\u0435\u0441\u0430 10.20.0.10 \u2192 192.168.10.10. \u0412 VRF \u041C\u0422\u0421 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D \u043C\u0430\u0440\u0448\u0440\u0443\u0442 192.168.10.0/24 \u043A GRE \u043A\u043B\u0438\u0435\u043D\u0442\u0430. LAN \u043A\u043B\u0438\u0435\u043D\u0442\u0430, Modem IP Pool \u0438 P2P \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0442\u044C\u0441\u044F. \u041D\u0430\u043B\u0438\u0447\u0438\u0435 APN \u0441\u0430\u043C\u043E \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u043A \u0432\u043D\u0435\u0448\u043D\u0438\u043C \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C.", facts: [["\u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A", "10.20.0.10 \u2014 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0441 SIM"], ["\u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435", "192.168.10.10 \u2014 \u0441\u0435\u0440\u0432\u0435\u0440 LAN"], ["\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u041C\u0422\u0421", "192.168.10.0/24 \u0447\u0435\u0440\u0435\u0437 P2P \u043A\u043B\u0438\u0435\u043D\u0442\u0430"], ["\u041F\u0440\u0438\u043C\u0435\u0440 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438", "20 B IPv4 + 8 B ICMP + 32 B \u0434\u0430\u043D\u043D\u044B\u0445"]], events: [grePacket("client", "router", "blue", "IP \u041E\u0422 SIM", 0, greSIM, greServer, "ip")] },
      { title: "\u0418\u043D\u043A\u0430\u043F\u0441\u0443\u043B\u044F\u0446\u0438\u044F GRE", desc: "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IP \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u0432\u043E \u0432\u043D\u0435\u0448\u043D\u0438\u0439", detail: "\u041D\u0430 GRE-\u0443\u0437\u043B\u0435 \u041C\u0422\u0421 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439 IP-\u043F\u0430\u043A\u0435\u0442 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439 GRE. \u0414\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F 4 \u0431\u0430\u0439\u0442\u0430 GRE \u0438 20 \u0431\u0430\u0439\u0442 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E IPv4 \u0431\u0435\u0437 \u043E\u043F\u0446\u0438\u0439: \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A 198.51.100.10, \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 203.0.113.10, \u043F\u043E\u043B\u0435 Protocol = 47. \u041F\u043E\u043B\u0435 GRE Protocol Type = 0x0800 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IPv4. \u0422\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u0430\u044F \u0441\u0435\u0442\u044C \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u044E\u044E \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443 \u043C\u0435\u0436\u0434\u0443 \u043A\u043E\u043D\u0446\u0430\u043C\u0438 \u0442\u0443\u043D\u043D\u0435\u043B\u044F. \u0414\u0430\u043D\u043D\u044B\u0435 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438: GRE \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0435.", facts: [["\u0412\u043D\u0435\u0448\u043D\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u0430", "198.51.100.10 \u2192 203.0.113.10"], ["\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u0430", "10.20.0.10 \u2192 192.168.10.10"], ["\u0412\u043D\u0435\u0448\u043D\u0438\u0439 IP Protocol", "47 (GRE)"], ["GRE Protocol Type", "0x0800 (IPv4)"], ["\u0420\u0430\u0437\u043C\u0435\u0440", "60 + 24 = 84 B"]], events: [{ type: "show", nodes: ["internet", "web"], frame: "full" }, grePacket("router", "web", "amber", "GRE: IP \u0412\u041D\u0423\u0422\u0420\u0418 IP", 0.012, greMTS, greClient, "gre")] },
      { title: "\u0414\u0435\u043A\u0430\u043F\u0441\u0443\u043B\u044F\u0446\u0438\u044F", desc: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043E\u0440 \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443", detail: "\u041A\u043B\u0438\u0435\u043D\u0442\u0441\u043A\u0438\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043E\u0440 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 GRE \u043E\u0442 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u0443\u0437\u043B\u0430 \u041C\u0422\u0421, \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0439 IPv4 \u0438 GRE \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u043F\u0430\u043A\u0435\u0442\u0430. \u0421\u0435\u0440\u0432\u0435\u0440 192.168.10.10 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 LAN 192.168.10.0/24. \u041F\u0430\u043A\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u044D\u0442\u0443 \u0441\u0435\u0442\u044C \u0441 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u043C \u0430\u0434\u0440\u0435\u0441\u043E\u043C SIM 10.20.0.10. \u0414\u043B\u044F \u0441\u0432\u044F\u0437\u0438 \u0441 LAN \u0432 \u0434\u0430\u043D\u043D\u043E\u043C \u043F\u0440\u0438\u043C\u0435\u0440\u0435 NAT \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F. \u041D\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C L3-\u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435 \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F TTL \u0438 checksum; \u0430\u0434\u0440\u0435\u0441\u0430 \u0431\u0435\u0437 NAT \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F.", facts: [["\u0423\u0434\u0430\u043B\u044F\u0435\u0442\u0441\u044F", "\u0412\u043D\u0435\u0448\u043D\u0438\u0439 IPv4 + GRE"], ["\u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F", "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IP \u0438 \u0434\u0430\u043D\u043D\u044B\u0435"], ["\u041D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442", "10.20.0.10 \u2192 192.168.10.10"], ["LAN", "192.168.10.0/24"]], events: [{ type: "show", nodes: ["app"], frame: "full" }, grePacket("web", "app", "blue", "IP \u0412 \u0421\u0415\u0422\u042C \u041A\u041B\u0418\u0415\u041D\u0422\u0410", 0.032, greSIM, greServer, "ip")] },
      { title: "\u041E\u0442\u0432\u0435\u0442 \u043A SIM", desc: "\u041E\u0431\u0440\u0430\u0442\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0442\u0430\u043A \u0436\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u0435\u043D", detail: "\u0421\u0435\u0440\u0432\u0435\u0440 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0443 10.20.0.10. \u0412 LAN \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u043F\u0443\u0442\u044C \u043A Modem IP Pool \u0447\u0435\u0440\u0435\u0437 GRE-\u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043E\u0440 \u043A\u043B\u0438\u0435\u043D\u0442\u0430. \u041D\u0430 \u043D\u0451\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442 10.20.0.0/24 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A P2P-\u0430\u0434\u0440\u0435\u0441\u0443 \u041C\u0422\u0421 172.16.100.1 \u0447\u0435\u0440\u0435\u0437 GRE. \u041A\u043B\u0438\u0435\u043D\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u0430 203.0.113.10 \u2192 198.51.100.10. \u041C\u0422\u0421 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 GRE \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u043E\u0442\u0432\u0435\u0442 \u0432 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0443\u044E \u0441\u0435\u0441\u0441\u0438\u044E SIM. \u0411\u0435\u0437 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0433\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u0437\u0430\u043F\u0440\u043E\u0441 \u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0439\u0442\u0438, \u043D\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u043D\u0435 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.", facts: [["\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u043A\u043B\u0438\u0435\u043D\u0442\u0430", "10.20.0.0/24 \u0447\u0435\u0440\u0435\u0437 172.16.100.1"], ["\u0412\u043D\u0435\u0448\u043D\u0438\u0439 \u043E\u0442\u0432\u0435\u0442", "203.0.113.10 \u2192 198.51.100.10"], ["\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u043E\u0442\u0432\u0435\u0442", "192.168.10.10 \u2192 10.20.0.10"]], events: [grePacket("app", "web", "green", "\u041E\u0422\u0412\u0415\u0422 \u0421\u0415\u0420\u0412\u0415\u0420\u0410", 0.034, greServer, greSIM, "ip", true), grePacket("web", "router", "amber", "\u041E\u0422\u0412\u0415\u0422 \u0412 GRE", 0.036, greClient, greMTS, "gre", true), grePacket("router", "client", "green", "\u041E\u0422\u0412\u0415\u0422 \u041D\u0410 SIM", 0.056, greServer, greSIM, "ip", true)] },
      { title: "P2P /30", desc: "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u0430 \u043A\u043E\u043D\u0446\u043E\u0432 \u0442\u0443\u043D\u043D\u0435\u043B\u044F", detail: "\u0414\u043B\u044F \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0432\u044F\u0437\u0438 \u043A\u043E\u043D\u0446\u043E\u0432 \u0442\u0443\u043D\u043D\u0435\u043B\u044F \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0441\u0435\u0442\u044C 172.16.100.0/30. \u0412 \u043F\u0440\u0438\u043C\u0435\u0440\u0435 .0 \u2014 \u0430\u0434\u0440\u0435\u0441 \u0441\u0435\u0442\u0438, .1 \u2014 \u041C\u0422\u0421, .2 \u2014 \u043A\u043B\u0438\u0435\u043D\u0442, .3 \u2014 broadcast. P2P \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F Modem IP Pool \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u0432\u043D\u0435\u0448\u043D\u0438\u0435 WAN-\u0430\u0434\u0440\u0435\u0441\u0430. Ping \u043C\u0435\u0436\u0434\u0443 .1 \u0438 .2 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u0432\u043D\u0443\u0442\u0440\u0438 GRE, \u043D\u043E \u0435\u0449\u0451 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F SIM \u043A \u0441\u0435\u0440\u0432\u0435\u0440\u0443. \u0423 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E GRE \u043D\u0435\u0442 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u044F \u043A\u0430\u043A \u0443 TCP; \u0441\u0442\u0430\u0442\u0443\u0441 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u0442 \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C.", facts: [["P2P NETWORK", "172.16.100.0/30"], ["\u041C\u0422\u0421", "172.16.100.1/30"], ["\u041A\u043B\u0438\u0435\u043D\u0442", "172.16.100.2/30"], ["\u041D\u0435 \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0442\u044C \u0443\u0437\u043B\u0430\u043C", ".0 \u0438 .3"]], events: [grePacket("router", "web", "amber", "PING P2P \u0412 GRE", 0.1, greMTS, greClient, "gre", false, true), grePacket("web", "router", "green", "P2P \u041E\u0422\u0412\u0415\u0427\u0410\u0415\u0422", 0.12, greClient, greMTS, "gre", true, true)] },
      { title: "MTU \u0438 MSS", desc: "\u041E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E \u0432 \u043F\u0430\u043A\u0435\u0442\u0435", detail: "\u041F\u0440\u0438 MTU \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u043F\u0443\u0442\u0438 1500 \u0431\u0430\u0439\u0442 \u0438 \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435 IPv4 + GRE \u0432 24 \u0431\u0430\u0439\u0442\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440 MTU \u0442\u0443\u043D\u043D\u0435\u043B\u044F \u2014 1476. \u0414\u043B\u044F \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E IPv4/TCP \u0431\u0435\u0437 \u043E\u043F\u0446\u0438\u0439 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440 MSS \u2014 1436. \u042D\u0442\u0438 \u0447\u0438\u0441\u043B\u0430 \u043D\u0435 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B: GRE key/checksum, IPsec, PPPoE, IPv6 \u0438 \u043C\u0435\u043D\u044C\u0448\u0438\u0439 MTU \u043F\u0443\u0442\u0438 \u043C\u0435\u043D\u044F\u044E\u0442 \u0440\u0430\u0441\u0447\u0451\u0442. \u0415\u0441\u043B\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 ping \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442, \u0430 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442, \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 PMTUD, ICMP \u043E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438, MTU \u0438 MSS. \u041D\u0435 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F ICMP \u0431\u0435\u0437 \u0430\u043D\u0430\u043B\u0438\u0437\u0430.", facts: [["\u041F\u0440\u0438\u043C\u0435\u0440 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E MTU", "1500 B"], ["\u0411\u0430\u0437\u043E\u0432\u044B\u0439 GRE \u043F\u043E\u0432\u0435\u0440\u0445 IPv4", "24 B"], ["\u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440 MTU / MSS", "1476 / 1436 B"], ["\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430", "\u041F\u043E \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u043F\u0443\u0442\u0438 \u0438 \u0438\u043D\u043A\u0430\u043F\u0441\u0443\u043B\u044F\u0446\u0438\u0438"]], events: [{ type: "note", at: "web", text: "1500 \u2212 24 = 1476 B", tone: "navy" }] },
      { title: "\u0412\u044B\u0445\u043E\u0434 \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442", desc: "\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B, NAT \u0438 DNS", detail: "\u0412 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439 \u0441\u0445\u0435\u043C\u0435 \u0442\u0440\u0430\u0444\u0438\u043A \u0438\u0434\u0451\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 LAN. \u0414\u043B\u044F \u0432\u044B\u0445\u043E\u0434\u0430 SIM \u0432 \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438\u0437 APN \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u043C \u0447\u0435\u0440\u0435\u0437 GRE, \u0440\u0430\u0431\u043E\u0447\u0438\u0439 WAN \u0443 \u043A\u043B\u0438\u0435\u043D\u0442\u0430, \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F firewall \u0438 source NAT \u0434\u043B\u044F \u0447\u0430\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0443\u043B\u0430 SIM \u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0435. \u041E\u0442\u0432\u0435\u0442\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044E NAT \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u043A SIM \u0447\u0435\u0440\u0435\u0437 GRE. DNS \u0437\u0430\u0434\u0430\u0451\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E. NAT \u0434\u043B\u044F LAN \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u043D\u0443\u0436\u0435\u043D. GRE \u0431\u0435\u0437 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u0438 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u043A\u0430\u043D\u0430\u043B\u0430 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442.", facts: [["\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438\u0437 APN", "\u041D\u0443\u0436\u043D\u044B\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u0439 default"], ["Source NAT", "\u041F\u0443\u043B SIM \u2192 WAN \u043A\u043B\u0438\u0435\u043D\u0442\u0430"], ["\u041E\u0431\u0440\u0430\u0442\u043D\u044B\u0439 \u043F\u0443\u0442\u044C", "WAN \u2192 NAT \u2192 GRE \u2192 SIM"], ["DNS \u0438 ACL", "\u0421\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E"]], events: [{ type: "note", at: "web", text: "\u0418\u041D\u0422\u0415\u0420\u041D\u0415\u0422: \u041C\u0410\u0420\u0428\u0420\u0423\u0422 + NAT", tone: "navy" }] },
      { title: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u0430", desc: "\u0427\u0442\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0434 \u0437\u0430\u043F\u0443\u0441\u043A\u043E\u043C", detail: "\u0417\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u0435 \u0438\u043C\u044F APN, \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E SIM \u0438 Modem IP Pool; \u0432\u043D\u0435\u0448\u043D\u0438\u0435 IP \u043A\u043E\u043D\u0446\u043E\u0432 GRE; P2P /30; LAN-\u043F\u043E\u0434\u0441\u0435\u0442\u0438, \u043C\u043E\u0434\u0435\u043B\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0438\u0437\u0430\u0442\u043E\u0440\u0430 \u0438 \u0432\u0435\u0440\u0441\u0438\u044E \u041F\u041E; \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, IP/FQDN \u0438 \u043F\u043E\u0440\u0442\u044B \u0441\u0435\u0440\u0432\u0438\u0441\u0430; \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C NAT, DNS \u0438 \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u044F. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442, IP-\u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B 47, \u043E\u0431\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430, P2P, ACL \u0438 MTU, \u0437\u0430\u0442\u0435\u043C \u0442\u0435\u0441\u0442 \u0441 SIM \u0438 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u043D\u043E\u0439 \u0441\u0435\u0440\u0432\u0438\u0441. GRE \u0447\u0435\u0440\u0435\u0437 NAT \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F. \u0414\u043B\u044F \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u044B\u0439 GRE over IPsec: IPsec \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 GRE, \u043D\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u044B\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B. \u0410\u0434\u0440\u0435\u0441\u0430 \u0441\u0445\u0435\u043C\u044B \u0443\u0447\u0435\u0431\u043D\u044B\u0435, \u044D\u0442\u043E \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u043E\u0435 \u0422\u0417 \u041C\u0422\u0421.", facts: [["Firewall", "IP-\u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B 47, \u043D\u0435 \xAB\u043F\u043E\u0440\u0442 47\xBB"], ["GRE", "\u041D\u0435 \u0448\u0438\u0444\u0440\u0443\u0435\u0442 \u0438 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u0443\u0437\u043B\u0430"], ["GRE over IPsec", "\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u0438\u0435 IKE / ESP / NAT-T"], ["\u041F\u043E\u0440\u044F\u0434\u043E\u043A", "WAN \u2192 P2P \u2192 SIM/LAN \u2192 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435"]], events: [{ type: "note", at: "router", text: "GRE \u2260 \u0428\u0418\u0424\u0420\u041E\u0412\u0410\u041D\u0418\u0415", tone: "navy" }] }
    ]
  };
  function greChecksum(bytes) {
    let sum = 0;
    for (let i = 0; i < bytes.length; i += 2)
      sum += (bytes[i] << 8) + (bytes[i + 1] || 0);
    while (sum >>> 16)
      sum = (sum & 65535) + (sum >>> 16);
    return ~sum & 65535;
  }
  function greIPv4(src, dst, protocol, total, ttl) {
    const b = [69, 0, total >> 8, total & 255, 18, 52, 64, 0, ttl, protocol, 0, 0, ...src.split(".").map(Number), ...dst.split(".").map(Number)];
    let c = greChecksum(b);
    b[10] = c >> 8;
    b[11] = c & 255;
    return b;
  }
  function greFrame(event, index) {
    const w = event.row.wire, outer = w.kind === "gre";
    const body = Array.from({ length: 32 }, (_, i) => 65 + i % 26);
    let icmp = [w.reply ? 0 : 8, 0, 0, 0, 0, 1, 0, 1, ...body];
    let ck = greChecksum(icmp);
    icmp[2] = ck >> 8;
    icmp[3] = ck & 255;
    const ttl = event.from === "client" || event.from === "app" ? 64 : 63;
    const inner = greIPv4(w.innerSrc, w.innerDst, 1, 60, ttl);
    const bytes = outer ? [...greIPv4(event.row.src, event.row.dst, 47, 84, 64), 0, 0, 8, 0, ...inner, ...icmp] : [...inner, ...icmp];
    let layers = [], fields = [];
    const field = (layer, name, value, from, to, note = "") => fields.push({ layer, name, value: String(value), from, to, note, mono: true });
    const ipLayer = (id, offset, src, dst, proto, size, ttl2) => {
      layers.push({ id, name: (id === "outer" ? "\u0412\u043D\u0435\u0448\u043D\u0438\u0439 IPv4" : "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IPv4") + " \xB7 20 B", summary: src + " \u2192 " + dst, from: offset, to: offset + 20 });
      field(id, "Version / IHL", "IPv4 / 20 B", offset, offset + 1);
      field(id, "Total Length", size + " B", offset + 2, offset + 4);
      field(id, "Flags", "DF", offset + 6, offset + 8);
      field(id, "TTL", ttl2, offset + 8, offset + 9, "\u0423\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0432 \u0434\u0430\u043D\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F.");
      field(id, "Protocol", proto === 47 ? "47 \u2014 GRE" : "1 \u2014 ICMP", offset + 9, offset + 10);
      field(id, "Header checksum", "0x" + (bytes[offset + 10] << 8 | bytes[offset + 11]).toString(16).padStart(4, "0"), offset + 10, offset + 12);
      field(id, "Source", src, offset + 12, offset + 16);
      field(id, "Destination", dst, offset + 16, offset + 20);
    };
    if (outer) {
      ipLayer("outer", 0, event.row.src, event.row.dst, 47, 84, 64);
