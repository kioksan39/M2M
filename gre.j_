      field("gre", "Flags / Version", "0x0000 \xB7 \u0432\u0435\u0440\u0441\u0438\u044F 0", 20, 22, "\u0411\u0435\u0437 checksum, key \u0438 sequence.");
      field("gre", "Protocol Type", "0x0800 \u2014 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IPv4", 22, 24, "\u042D\u0442\u043E \u0442\u0438\u043F \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438, \u043D\u0435 \u043D\u043E\u043C\u0435\u0440 \u043F\u043E\u0440\u0442\u0430.");
    }
    let o = outer ? 24 : 0;
    ipLayer("inner", o, w.innerSrc, w.innerDst, 1, 60, ttl);
    o += 20;
    layers.push({ id: "icmp", name: "ICMP \xB7 8 B", summary: w.reply ? "Echo reply" : "Echo request", from: o, to: o + 8 });
    field("icmp", "Type / Code", w.reply ? "0 / 0 \u2014 Echo reply" : "8 / 0 \u2014 Echo request", o, o + 2);
    field("icmp", "Checksum", "0x" + ck.toString(16).padStart(4, "0"), o + 2, o + 4);
    field("icmp", "Identifier / Sequence", "1 / 1", o + 4, o + 8);
    layers.push({ id: "payload", name: "\u0414\u0430\u043D\u043D\u044B\u0435 \xB7 32 B", summary: "\u0423\u0447\u0435\u0431\u043D\u0430\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430", from: o + 8, to: o + 40 });
    field("payload", "Payload", String.fromCharCode(...body), o + 8, o + 40, "\u041E\u0434\u043D\u0438 \u0438 \u0442\u0435 \u0436\u0435 \u0434\u0430\u043D\u043D\u044B\u0435 \u0437\u0430\u043F\u0440\u043E\u0441\u0430 \u0438 \u043E\u0442\u0432\u0435\u0442\u0430.");
    return { index, at: outer ? "\u041D\u0430 \u0432\u043D\u0435\u0448\u043D\u0435\u043C IP-\u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0435 \u043C\u0435\u0436\u0434\u0443 \u043A\u043E\u043D\u0446\u0430\u043C\u0438 GRE; \u0431\u0435\u0437 L2-\u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0430" : "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 IP-\u043F\u0430\u043A\u0435\u0442 \u043D\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435; \u0440\u0430\u0434\u0438\u043E\u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B \u0438 L2 \u043E\u043F\u0443\u0449\u0435\u043D\u044B", bytes, fields, layers, segments: 1, tcp: null, messageLength: null };
