/* PNG создаётся из SVG, отображаемого на сайте. Иконки и пути не перерисовываются.
   Цвета, шрифт, позиции и видимость берутся из вычисленных стилей в момент клика.
   Редактируйте компоновку и описание здесь; размеры — в config.js. */
function setupGuideExport() {
  const button = document.getElementById('guide-png');
  const status = document.querySelector('.guide-status');
  const properties = ['display','visibility','opacity','fill','fill-opacity','fill-rule','stroke','stroke-width','stroke-opacity','stroke-dasharray','stroke-dashoffset','stroke-linecap','stroke-linejoin','stroke-miterlimit','color','font-family','font-size','font-weight','font-style','letter-spacing','text-anchor','dominant-baseline','paint-order','vector-effect','transform','transform-origin','transform-box','filter','clip-path','mask','stop-color','stop-opacity'];

  function freezeSVG(source, width, height) {
    const clone = source.cloneNode(true);
    const originals = [source, ...source.querySelectorAll('*')];
    const copies = [clone, ...clone.querySelectorAll('*')];
    originals.forEach((node, index) => {
      const css = getComputedStyle(node), copy = copies[index];
      copy.removeAttribute('style');
      properties.forEach(key => {
        let value = css.getPropertyValue(key);
        // Сделать ссылки на градиенты/маски локальными для автономного SVG.
        value = value.replace(/url\(["']?[^)"']*#([^)'"\s]+)["']?\)/g, 'url(#$1)');
        if (value) copy.style.setProperty(key,value);
      });
      copy.style.animation = 'none';
      copy.style.transition = 'none';
    });
    clone.setAttribute('xmlns','http://www.w3.org/2000/svg');
    clone.setAttribute('width',width);
    clone.setAttribute('height',height);
    clone.style.width = width+'px'; clone.style.height = height+'px';
    clone.style.transform = 'none';
    const style = document.createElementNS('http://www.w3.org/2000/svg','style');
    style.textContent = window.PROTOCOL_GUIDE_EXPORT_FONTS || '';
    clone.insertBefore(style,clone.firstChild);
    return new XMLSerializer().serializeToString(clone);
  }

  function wrap(ctx,text,width) {
    const lines=[];
    for(const paragraph of text.split('\n')) {
      let line='';
      for(const word of paragraph.split(/\s+/)) {
        if(ctx.measureText(line+word).width>width && line) {lines.push(line.trimEnd());line='';}
        // Длинные APN и адреса не выходят за край PNG.
        for(const ch of word+' ') {
          if(ctx.measureText(line+ch).width>width && line) {lines.push(line);line='';}
          line+=ch;
        }
      }
      lines.push(line.trimEnd());
    }
    return lines;
  }

  button.onclick = async () => {
    button.disabled=true;
    status.textContent='Подготавливаю PNG…';
    try {
      await document.fonts.ready;
      const source=document.querySelector('svg.network');
      if(!source) throw new Error('Схема не найдена');
      // Зафиксировать текущий пакет, чтобы снимок и описание относились к одному шагу.
      const pause=document.querySelector('[data-action="toggle"]');
      if(pause?.textContent.trim()==='ПАУЗА') pause.click();
      const o=window.PROTOCOL_GUIDE_CONFIG.png;
      const width=o.width, pad=o.padding, side=o.descriptionWidth;
      const drawingWidth=width-side-pad*3, drawingHeight=o.diagramHeight;
      const root=getComputedStyle(document.documentElement);
      const font=root.fontFamily,ink=root.getPropertyValue('--ink').trim(),background=root.getPropertyValue('--bg').trim();
      const active=document.querySelector('.overview-body:not([hidden])');
      const title=active?.querySelector('h3')?.textContent || 'GRE';
      const description=active?.querySelector('.explain-text,.overview-desc')?.textContent || '';
      const facts=Array.from(active?.querySelectorAll('dl > div')||[]).map(row=>row.innerText.replace(/\s*\n\s*/g,': '));
      const canvas=document.createElement('canvas'),ctx=canvas.getContext('2d');
      ctx.font='18px '+font;
      const textLines=wrap(ctx,description+'\n\n'+facts.join('\n\n'),side-32);
      const height=Math.max(drawingHeight+130,205+textLines.length*25);
      canvas.width=Math.round(width*o.scale);canvas.height=Math.round(height*o.scale);
      ctx.scale(o.scale,o.scale);
      ctx.fillStyle=background;ctx.fillRect(0,0,width,height);
      ctx.fillStyle=ink;ctx.font='bold 28px '+font;ctx.fillText('PROTOCOL GUIDE · '+title,pad,48);
      ctx.font='16px '+font;ctx.fillText('Схема и описание выбранного этапа',pad,78);
      const xml=freezeSVG(source,drawingWidth,drawingHeight);
      const url=URL.createObjectURL(new Blob([xml],{type:'image/svg+xml;charset=utf-8'}));
      try {
        const image=new Image();
        await new Promise((resolve,reject)=>{image.onload=resolve;image.onerror=reject;image.src=url});
        ctx.drawImage(image,pad,100,drawingWidth,drawingHeight);
      } finally {URL.revokeObjectURL(url)}
      ctx.strokeStyle=root.getPropertyValue('--line').trim();ctx.lineWidth=1;
      ctx.strokeRect(pad,100,drawingWidth,drawingHeight);
      const textX=pad*2+drawingWidth;
      ctx.strokeRect(textX,100,side,height-130);
      ctx.fillStyle=ink;ctx.font='bold 20px '+font;ctx.fillText('ОПИСАНИЕ',textX+16,132);
      ctx.font='18px '+font;
      textLines.forEach((line,i)=>ctx.fillText(line,textX+16,166+i*25));
      const blob=await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('Не удалось создать PNG')),'image/png'));
      const downloadURL=URL.createObjectURL(blob),link=document.createElement('a');
      link.href=downloadURL;link.download=o.filename;link.click();
      setTimeout(()=>URL.revokeObjectURL(downloadURL),15000);
      status.textContent='PNG готов: схема, маршрут и описание';
      setTimeout(()=>status.textContent='',5000);
    } catch(error) {
      console.error(error);status.textContent='Ошибка экспорта PNG. Попробуйте открыть сайт через локальный сервер.';
    } finally {button.disabled=false}
  };
}
if(window.ProtocolGuide) setupGuideExport(); else document.addEventListener("protocol-guide-ready",setupGuideExport);
